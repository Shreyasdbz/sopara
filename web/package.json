{
  "name": "@sopara/web",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx}\"",
    "check": "bun run api:check && bun run format:check && bun run lint && bun run typecheck && bun run test",
    "typecheck": "tsc --noEmit",
    "api:generate": "../scripts/generate_api_types.sh",
    "api:check": "../scripts/generate_api_types.sh --check"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
